# News Trace fixture-milestone configuration.
# Copy to .env and adjust only if needed. Do NOT put secrets here.

# Explicit mode: only "fixture" is implemented in this milestone.
NEWS_TRACE_MODE=fixture
NEWS_TRACE_FIXTURE_PATH=fixtures/riverbend_fixture.json

# Local-only services. Keep both bound to loopback.
NEWS_TRACE_MCP_HOST=127.0.0.1
NEWS_TRACE_MCP_PORT=8765
NEWS_TRACE_MCP_URL=http://127.0.0.1:8765/mcp
NEWS_TRACE_GATEWAY_HOST=127.0.0.1
NEWS_TRACE_GATEWAY_PORT=8000

# Host/Origin allow-lists for local development.
NEWS_TRACE_ALLOWED_HOSTS=127.0.0.1:8000,localhost:8000,127.0.0.1:8765,localhost:8765
NEWS_TRACE_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173

# Frontend fixture entry point (Vite exposes only VITE_* values).
VITE_FIXTURE_MODE=true
VITE_FIXTURE_RESEARCH_ID=fixture-riverbend
VITE_API_BASE=/api/v1

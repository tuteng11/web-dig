# Local runtime configuration for the Traceback UI.
# Copy this file to `.env.local` and adjust only if needed.
#
# Demo transport controls where the explicit synthetic demo reads graph and
# node data:
#   gateway (default) - read-only fixture reads through the configured
#                       backend gateway/MCP. Demo jobs are not implemented.
#   bundled           - fully offline in-browser simulation; no backend request.
# VITE_DEMO_TRANSPORT wins over VITE_FIXTURE_MODE for demo transport selection.
VITE_DEMO_TRANSPORT=gateway
# Fixture mode keeps live discovery disabled. Set to false only when a
# same-origin gateway implementing /api/v1 is running for live research.
VITE_FIXTURE_MODE=true
VITE_API_BASE=/api/v1
VITE_FIXTURE_RESEARCH_ID=fixture-riverbend
